# Server Manager privileged helper: root, but no network at all. Listens only on
# /run/sm-agent/privd.sock (group smagent, mode 0660) and runs only commands signed by
# the control plane.
[Unit]
Description=Server Manager privileged helper
Documentation=https://github.com/monirujjaman-dev/server-manager
Before=sm-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/sm-agent privd
Restart=always
RestartSec=5
Environment=SM_PRIVD_AGENT_USER=smagent

RuntimeDirectory=sm-agent
RuntimeDirectoryMode=0750
# Swap: the helper writes only its state directory, /var/lib/smswap (the swapfile is
# 0600). The package ships the swap unit and links /etc/sysctl.d/90-sm-swappiness.conf
# into it; the helper enables and starts the unit over D-Bus, so systemd does swapon and
# applies sysctl settings. No CAP_SYS_ADMIN, no write access to /etc, /proc/sys stays
# read-only.
StateDirectory=smswap
StateDirectoryMode=0755
# No network namespace access: only filesystem UNIX sockets work (its own, D-Bus, and
# the Docker daemon's /run/docker.sock for docker.* actions; SM_PRIVD_DOCKER_SOCKET
# changes the path). The agent itself never gets Docker access: it is root-equivalent.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# CAP_KILL: signal processes. CAP_CHOWN: give the socket to the agent's group.
# It trusts only /etc/sm-agent-trust (root-owned, checked at load) and never reads the
# agent's own directory, so it needs no CAP_DAC_READ_SEARCH.
CapabilityBoundingSet=CAP_KILL CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
