# Server Manager agent: unprivileged, network-facing. Privileged actions are forwarded to
# sm-agent-privd.service over a local socket.
[Unit]
Description=Server Manager agent
Documentation=https://github.com/monirujjaman-dev/server-manager
Wants=network-online.target sm-agent-privd.service
After=network-online.target sm-agent-privd.service
# Start only after `sm-agent enroll` wrote the configuration.
ConditionPathExists=/etc/sm-agent/agent.yaml

[Service]
Type=simple
User=smagent
Group=smagent
# Read the system journal for logs.query and logs.auth.
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/sm-agent run --config /etc/sm-agent/agent.yaml
# Verify commands with the root-owned key (also for agent.yaml files written before
# the trust directory existed, which point at a copy in /etc/sm-agent).
Environment=SM_AGENT_COMMAND_KEY_FILE=/etc/sm-agent-trust/command.pub
Restart=always
RestartSec=5

# The agent rewrites its certificate on renewal. /etc/sm-agent-trust stays read-only.
ReadWritePaths=/etc/sm-agent
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=256M

[Install]
WantedBy=multi-user.target
